# FinFlow — Environment Variables
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# ── App ───────────────────────────────────────────────────
APP_ENV=Development
# Valores válidos: Development | Production

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=finflow
POSTGRES_USER=finflow
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT=5432

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARS_SECRET_KEY_HERE
JWT_ISSUER=finflow
JWT_AUDIENCE=finflow-users
JWT_EXPIRES_MINUTES=60
JWT_REFRESH_EXPIRES_DAYS=7

# ── Google Gemini ─────────────────────────────────────────
GEMINI_API_KEY=AIzaSyD1UVjSyD2tORCoh9FNA3AvN33wvFVq5VQ
# Obtenha em: https://aistudio.google.com/app/apikey

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200

# ── Portas dos Containers ─────────────────────────────────
BACKEND_PORT=5000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
